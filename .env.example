# Copiá este archivo como .env.local y completalo con los valores de tu proyecto.
# De dónde sale cada valor: docs/configuracion-externa.md

# Públicas: el proyecto de Supabase y su publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example

# Solo servidor: conexión de la app, por el transaction pooler (puerto 6543).
DATABASE_URL=postgresql://postgres.example:password@example.pooler.supabase.com:6543/postgres

# Opcional: conexiones simultáneas por instancia de la app.
# DATABASE_POOL_MAX=10

# Solo en tu PC: conexión de drizzle-kit, por el session pooler (puerto 5432).
DATABASE_MIGRATION_URL=postgresql://postgres.example:password@example.pooler.supabase.com:5432/postgres

# Solo servidor: app de Twitch, para buscar en IGDB.
TWITCH_CLIENT_ID=example
TWITCH_CLIENT_SECRET=example

# Opcionales: solo los cambian los tests e2e, que usan un servidor falso.
# IGDB_API_URL=https://api.igdb.com/v4
# TWITCH_TOKEN_URL=https://id.twitch.tv/oauth2/token

# Solo servidor: secret key de Supabase, para subir portadas. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_example
